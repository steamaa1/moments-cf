name = "__WORKER_NAME__"
main = "src/index.js"
compatibility_date = "2026-08-06"

[assets]
directory = "../front/.output/public"
binding = "ASSETS"
# 动态 API、媒体及站点资源必须先交由 Worker 处理，不能被 SPA Assets 回退吞掉。
# "/*" 全匹配：HTML 页面需经 Worker 注入后台配置的 SEO meta（爬虫可见），
# 静态资源由 Worker 转发给 Assets 并保留原响应头。
run_worker_first = ["/*"]
not_found_handling = "single-page-application"
# 规范 URL 统一无尾斜杠：/photos 直出 200，/photos/ 307 回到 /photos。
# 默认的 auto-trailing-slash 会让 /photos 307 跳到 /photos/，而 sitemap 与 canonical 用的是无斜杠版，
# Google 因此报「重复网页，Google 选择的规范网页与用户指定的不同」。
html_handling = "drop-trailing-slash"

[[d1_databases]]
binding = "DB"
database_name = "__D1_DATABASE_NAME__"
database_id = "__D1_DATABASE_ID__"
migrations_dir = "migrations"

[triggers]
crons = ["0 3 * * SUN"]

[[r2_buckets]]
binding = "MEDIA"
bucket_name = "__R2_BUCKET_NAME__"

[vars]
CORS_ORIGIN = "*"
CLOUDFLARE_ACCOUNT_ID = "__CLOUDFLARE_ACCOUNT_ID__"
D1_DATABASE_ID = "__D1_DATABASE_ID__"
R2_BUCKET_NAME = "__R2_BUCKET_NAME__"
# Configure JWT_SECRET and INIT_SECRET as encrypted Worker Secrets.
# Optional: PBKDF2_ITERATIONS (default 100000)
